<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Enables larger memory headroom on iPad Pro (8 GB RAM) for local GGUF and Core ML models.
	     Requires the "Increased Memory Limit" capability to be enabled for your App ID in Apple Developer Portal
	     when building signed IPAs. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
