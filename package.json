{
  "name": "zinoagent",
  "private": true,
  "version": "0.1.0",
  "description": "ZinoAgent — offline + cloud AI workspace for iPad (Capacitor + React + native Swift).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync ios",
    "ios:prepare": "bash scripts/build-llama-xcframework.sh"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "three": "0.187.0",
    "zino-native": "file:native/zino-native",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
